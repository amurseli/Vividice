---
/*
  Card genérica para listados de entries de la wiki (lugares, personajes,
  ...). Es deliberadamente agnóstica del collection: recibe props simples,
  no la entry. Así cualquier página la puede usar mapeando sus campos.

  Variantes:
    - default: card compacta para grid
    - hero:    card full-width destacada (ej: la home de Vivídice)

  Image handling:
    - Si imagen empieza con http(s):// → se usa como URL externa
    - Si no, se resuelve relativa al BASE_URL (sirve archivos de /public)
    - Si no hay imagen, la card cae en layout text-only
*/
import { url } from '../lib/url';
import ShaderBackground from './ShaderBackground.tsx';

type Props = {
  href: string;
  title: string;
  kicker?: string | null;
  description?: string | null;
  imagen?: string | null;
  imagenAlt?: string;
  /* Variantes:
       default - card compacta para grid
       hero    - card destacada full-width (Vivídice en su categoría)
       section - card de navegación tipo "sección" (categorías en /lugares) */
  variant?: 'default' | 'hero' | 'section';
  /* shaderBg=true: renderiza un canvas con el shader como fondo de la
     card, más overlay oscuro para mantener legible el texto. Cada card
     es su propio contexto WebGL — usar con moderación (Chrome aguanta
     ~16 globales). client:visible difiere la inicialización hasta que
     la card entre al viewport. */
  shaderBg?: boolean;
  /* shaderSeed: número arbitrario (0..1 típico) que desplaza el noise
     y la fase de tiempo del shader, para que múltiples cards en la misma
     página no se vean idénticas. */
  shaderSeed?: number;
};

const {
  href,
  title,
  kicker,
  description,
  imagen,
  imagenAlt,
  variant = 'default',
  shaderBg = false,
  shaderSeed = 0,
} = Astro.props;

const imageSrc = imagen
  ? imagen.startsWith('http') ? imagen : url(imagen)
  : null;
---

<a
  href={href}
  class:list={[
    'entry-card',
    `entry-card--${variant}`,
    { 'entry-card--with-image': imageSrc },
    { 'entry-card--shader': shaderBg },
  ]}
>
  {shaderBg && (
    <div class="entry-card__shader" aria-hidden="true">
      <ShaderBackground client:visible seed={shaderSeed} />
    </div>
  )}
  {imageSrc && (
    <div class="entry-card__media">
      <img src={imageSrc} alt={imagenAlt ?? title} loading="lazy" />
    </div>
  )}
  <div class="entry-card__body">
    {kicker && <p class="entry-card__kicker">{kicker}</p>}
    <h2 class="entry-card__title">{title}</h2>
    {description && <p class="entry-card__desc">{description}</p>}
  </div>
  <span class="entry-card__cta" aria-hidden="true">→</span>
</a>

<style>
  .entry-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden; /* el border-radius corta la imagen */
    position: relative;
    transition: border-color 120ms ease, transform 120ms ease;
  }

  .entry-card:hover {
    border-color: var(--color-accent);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .entry-card__media {
    /* aspect-ratio define la proporción sin importar el tamaño real
       de la imagen. object-fit: cover llena el espacio sin deformar. */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg);
  }

  .entry-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .entry-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .entry-card--with-image .entry-card__body {
    padding-top: var(--space-3);
  }

  .entry-card__kicker {
    margin: 0;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }

  .entry-card__title {
    margin: 0;
    font-family: var(--font-serif);
  }

  .entry-card__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .entry-card__cta {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    color: var(--color-text-muted);
    transition: color 120ms ease, transform 120ms ease;
  }

  /* Cuando hay imagen, la flecha la pisaría — la sacamos. */
  .entry-card--with-image .entry-card__cta {
    display: none;
  }

  .entry-card:hover .entry-card__cta {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  /*
    Variante con shader: canvas propio detrás del contenido, overlay
    oscuro para legibilidad. Cada card abre su propio contexto WebGL.
  */
  .entry-card__shader {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Overlay oscuro encima del shader, dentro de la misma card */
  .entry-card__shader::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(37, 52, 63, 0.88) 0%,
      rgba(37, 52, 63, 0.55) 50%,
      rgba(37, 52, 63, 0.78) 100%
    );
  }

  .entry-card--shader {
    background: transparent;
  }

  .entry-card--shader .entry-card__body,
  .entry-card--shader .entry-card__cta,
  .entry-card--shader .entry-card__media {
    position: relative;
    z-index: 1;
  }

  /* Variantes */
  .entry-card--default .entry-card__title {
    font-size: 1.4rem;
  }

  .entry-card--hero {
    background: linear-gradient(
      135deg,
      var(--color-surface) 0%,
      color-mix(in srgb, var(--color-surface) 85%, var(--color-accent)) 100%
    );
  }

  .entry-card--hero .entry-card__title {
    font-size: 2.5rem;
  }

  .entry-card--hero .entry-card__desc {
    font-size: 1.1rem;
    max-width: 60ch;
  }

  /* Hero sin imagen: padding generoso */
  .entry-card--hero:not(.entry-card--with-image) .entry-card__body {
    padding: var(--space-6) var(--space-5);
  }

  /* Hero con imagen en desktop: split horizontal (imagen izq, texto der) */
  @media (min-width: 720px) {
    .entry-card--hero.entry-card--with-image {
      flex-direction: row;
    }
    .entry-card--hero.entry-card--with-image .entry-card__media {
      flex: 0 0 45%;
      aspect-ratio: auto;
    }
    .entry-card--hero.entry-card--with-image .entry-card__body {
      flex: 1;
      justify-content: center;
      padding: var(--space-6);
    }
  }

  /*
    Variante "section": cards grandes tipo navegación / capítulo.
    - Padding generoso
    - Tipografía mucho más grande
    - Barra de acento a la izquierda que crece en hover
    - Arrow grande centrada vertical
  */
  .entry-card--section {
    border-radius: 16px;
    transition: border-color 250ms ease, transform 250ms ease,
      background 250ms ease;
  }

  .entry-card--section::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 300ms ease;
  }

  .entry-card--section:hover {
    transform: translateY(-3px);
    background: color-mix(
      in srgb,
      var(--color-surface) 90%,
      var(--color-accent)
    );
  }

  .entry-card--section:hover::before {
    transform: scaleY(1);
  }

  .entry-card--section .entry-card__body {
    padding: var(--space-4);
    padding-left: calc(var(--space-6) + 4px);
    gap: var(--space-3);
  }

  .entry-card--section .entry-card__kicker {
    font-size: 0.75rem;
  }

  .entry-card--section .entry-card__title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.1;
  }

  .entry-card--section .entry-card__desc {
    font-size: 1.05rem;
  }

  .entry-card--section .entry-card__cta {
    position: absolute;
    top: 50%;
    right: var(--space-5);
    transform: translateY(-50%);
    font-size: 1.75rem;
    transition: transform 200ms ease, color 200ms ease;
  }

  .entry-card--section:hover .entry-card__cta {
    color: var(--color-accent);
    transform: translateY(-50%) translateX(6px);
  }
</style>
