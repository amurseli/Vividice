---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.tsx';
import VisualNovel from '../components/VisualNovel.tsx';
import intro from '../data/intro.json';
import { url } from '../lib/url';
---

<BaseLayout title="Inicio" width="bleed" hideFooter hideNav>
  {/*
    Intro tipo novela visual. El shader (negro + flujo rojo) es el fondo;
    VisualNovel se monta encima y maneja el guion (src/data/intro.json),
    el typewriter y el botón de skip. Al terminar o saltear -> /lugares.
  */}
  <div class="intro-stage">
    <div class="intro-stage__bg">
      <ShaderBackground client:only="react" />
    </div>
    <VisualNovel client:load script={intro} skipHref={url('lugares')} />
  </div>
</BaseLayout>

<style>
  .intro-stage {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
  }
  .intro-stage__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
</style>
