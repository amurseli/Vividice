---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShaderBackground from '../components/ShaderBackground.tsx';
---

<BaseLayout title="Inicio" width="bleed" hideFooter transparentNav>
  <div class="shader-stage">
    <ShaderBackground client:only="react" />
  </div>
</BaseLayout>

<style>
  /*
    bleed + hideFooter: el body es flex column → navbar arriba, .content
    rellena el resto del viewport (flex: 1). Como no hay footer, el shader
    ocupa todo el espacio entre el bottom del navbar y el bottom de la pantalla.

    El min-height asegura que aún si por algo el flex no estira el padre,
    el canvas tenga altura razonable.
  */
  .shader-stage {
    width: 100%;
    /* 100dvh = dynamic viewport height: en mobile se ajusta cuando aparece
       o desaparece la barra del browser. En desktop equivale a 100vh.
       Antes usaba "100% + min-height: calc(100vh - 5rem)" para descontar la
       navbar, pero como ahora la navbar es absolute (transparentNav) no resta
       espacio y dejaba 5rem de body asomando abajo. */
    height: 100dvh;
  }
</style>
