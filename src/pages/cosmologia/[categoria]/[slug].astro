---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  categoriaDe,
  nombreDe,
  urlCategoria,
  type Concepto,
} from '../../../lib/cosmologia';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const conceptos = await getCollection('cosmologia');
  return (conceptos as Concepto[])
    .map((concepto) => {
      const cat = categoriaDe(concepto);
      if (!cat) return null;
      return {
        params: { categoria: cat.slug, slug: concepto.id },
        props: { concepto },
      };
    })
    .filter((p): p is NonNullable<typeof p> => p !== null);
}

type Props = { concepto: Concepto };
const { concepto } = Astro.props;
const cat = categoriaDe(concepto);

const { Content } = await render(concepto);
const nombre = nombreDe(concepto);
const { aliases } = concepto.data;
---

<BaseLayout title={nombre}>
  <article>
    <p class="breadcrumb">
      <a href={url('cosmologia')}>Cosmología</a>
      <span aria-hidden="true">›</span>
      {cat && <a href={urlCategoria(cat)}>{cat.label}</a>}
      {cat && <span aria-hidden="true">›</span>}
      <span>{nombre}</span>
    </p>

    <header class="concepto-header">
      {cat && <p class="kicker">{cat.label}</p>}
      <h1>{nombre}</h1>

      {aliases.length > 0 && (
        <p class="aliases">También conocido como: {aliases.join(', ')}</p>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 var(--space-4);
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: var(--color-text-muted);
  }
  .breadcrumb a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .concepto-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .kicker {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    margin: 0 0 var(--space-2);
  }
  .aliases {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-style: italic;
    margin: var(--space-3) 0 0;
  }
</style>
