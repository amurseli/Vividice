    </section>

  </div>
</BaseLayout>

<style>
  .guia {
    width: 100%;
  }

  .seccion {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    padding: clamp(6rem, 14vh, 10rem) clamp(2rem, 8vw, 8rem) var(--space-6);
  }

  .seccion--oscura {
    background-color: var(--color-bg);
    color: var(--color-accent);
  }

  .seccion--clara {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  .seccion__inner {
    width: 100%;
  }

  .seccion__titulo {
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 10.8vw, 12.6rem);
    line-height: 1;
    margin: 0 0 var(--space-5);
    color: inherit;
  }

  .seccion--clara .seccion__titulo {
    text-align: right;
  }

  .seccion__parrafos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .seccion__parrafos--tres {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .seccion__columna {
    padding: 0 var(--space-6);
    border-right: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .seccion__columna:first-child {
    padding-left: 0;
  }

  .seccion__columna:last-child {
    padding-right: 0;
    border-right: none;
  }

  .seccion__subtitulo {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    margin: 0 0 var(--space-3);
    color: inherit;
  }

  .seccion--clara .seccion__subtitulo {
    text-align: right;
  }

  .seccion__parrafo {
    margin: 0;
    padding: 0 var(--space-6);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.8;
    color: inherit;
    white-space: pre-line;
    border-right: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .seccion__parrafo:first-child {
    padding-left: 0;
  }

  .seccion__parrafo:last-child {
    padding-right: 0;
    border-right: none;
  }

  .seccion__columna .seccion__parrafo {
    padding: 0;
    border-right: none;
  }

  .seccion--clara .seccion__parrafos:not(.seccion__parrafos--tres) {
    grid-template-columns: 1fr;
  }

  .seccion--clara .seccion__parrafo {
    text-align: right;
    border-right: none;
    padding: 0;
  }

  .seccion--clara .seccion__columna {
    text-align: right;
  }

  @media (max-width: 768px) {
    .seccion__parrafos,
    .seccion__parrafos--tres {
      grid-template-columns: 1fr;
    }

    .seccion__parrafo {
      padding: 0 0 var(--space-4);
      border-right: none;
      border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    }

    .seccion__parrafo:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    .seccion__columna {
      padding: 0 0 var(--space-4);
      border-right: none;
      border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    }

    .seccion__columna:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }
  }
</style>
