---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShaderBackground from '../../../components/ShaderBackground.tsx';
import VisualNovel from '../../../components/VisualNovel.tsx';
import { PRELUDIOS } from '../../../lib/preludios';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  return Object.entries(PRELUDIOS).map(([numero, script]) => ({
    params: { numero },
    props: { script },
  }));
}

const { script } = Astro.props;
---

<BaseLayout title="Preludio" width="bleed" hideFooter hideNav>
  <div class="intro-stage">
    <div class="intro-stage__bg">
      <ShaderBackground client:only="react" />
    </div>
    <VisualNovel client:load script={script} skipHref={url('historias')} />
  </div>
</BaseLayout>

<style>
  .intro-stage {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
  }
  .intro-stage__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
</style>
