---
/*
  Layout: estructura HTML compartida (head, body, navbar, footer).
  Las páginas la usan así:
    <BaseLayout title="Personajes">
      ...contenido de la página...
    </BaseLayout>
  Y <slot /> es donde se inyecta ese contenido.
*/
import '../styles/global.css';
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.astro';

type Props = {
  title: string;
  /* Ancho del main:
       narrow (default) - 72ch, para artículos/lectura
       wide             - 1000px, listados con buena legibilidad
       full             - casi todo el viewport, padding adaptativo
       bleed            - sin padding ni max-width (ej: shader fullscreen) */
  width?: 'narrow' | 'wide' | 'full' | 'bleed';
  /* hideFooter=true: oculta el footer (home con shader fullscreen, por ej.) */
  hideFooter?: boolean;
  /* transparentNav=true: navbar sin fondo + overlay (sale del flujo) para
     que el contenido fullscreen detrás se vea. */
  transparentNav?: boolean;
  /* hideNav=true: no renderiza la navbar (ej: la intro tipo novela visual,
     que sólo expone su propio botón de skip). */
  hideNav?: boolean;
};
const {
  title,
  width = 'narrow',
  hideFooter = false,
  transparentNav = false,
  hideNav = false,
} = Astro.props;

/* Astro.url.pathname es la URL actual ya con el base aplicado.
   Lo pasamos a la Navbar para marcar el link activo. */
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Vividice</title>
  </head>
  <body>
    {/*
      client:load = hidrata el componente apenas carga la página.
      Otras opciones: client:visible (cuando entra al viewport),
      client:idle (cuando el browser está ocioso), client:only="react"
      (solo en cliente, no SSR).
    */}
    {!hideNav && (
      <Navbar
        client:load
        currentPath={currentPath}
        base={base}
        transparent={transparentNav}
      />
    )}

    <main class:list={['content', `content--${width}`]}>
      <slot />
    </main>

    {!hideFooter && <Footer />}

    <style>
      .content {
        margin: 0 auto;
        padding: var(--space-6) var(--space-5);
        flex: 1;        /* rellena espacio entre navbar y footer */
        width: 100%;
      }
      .content--narrow {
        max-width: var(--content-max-width);
      }
      .content--wide {
        max-width: 1000px;
      }
      .content--full {
        /* Sin cap rígido. Padding crece con el viewport entre 2rem y 6rem. */
        max-width: none;
        padding-left: clamp(var(--space-5), 5vw, 6rem);
        padding-right: clamp(var(--space-5), 5vw, 6rem);
      }
      .content--bleed {
        max-width: none;
        padding: 0;
        display: flex;  /* permite que el hijo use height: 100% */
      }
    </style>
  </body>
</html>
